<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd"><munit:config name="tests"/><munit:test name="hello-test"><munit:execution><flow-ref name="helloFlow"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo('Hello, Mule!')]"/></munit:validation></munit:test><munit:test name="order-total-test"><munit:behavior><munit:set-event><munit:payload value="#[output application/json --- {orderId:'A-MUNIT',items:[{price:12.5,qty:2},{price:7,qty:1}]}]" mediaType="application/json"/></munit:set-event></munit:behavior><munit:execution><flow-ref name="orderSummary"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.id]" is="#[MunitTools::equalTo('A-MUNIT')]"/><munit-tools:assert-that expression="#[payload.total]" is="#[MunitTools::equalTo(32)]"/></munit:validation></munit:test><munit:test name="target-restores-event-test"><munit:execution><flow-ref name="targetCaller"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.marker]" is="#[MunitTools::equalTo('original')]"/><munit-tools:assert-that expression="#[payload.result]" is="#[MunitTools::equalTo('after')]"/></munit:validation></munit:test><munit:test name="mock-shipping-test"><munit:behavior><munit:set-event><munit:payload value="#[output application/json --- readUrl('classpath://orders/a-1001.json','application/json')]" mediaType="application/json"/></munit:set-event><munit-tools:moc