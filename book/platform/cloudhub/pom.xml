<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>${exchange.organizationId}</groupId>
  <artifactId>orders-cloud-reference</artifactId>
  <version>2.0.0</version>
  <packaging>mule-application</packaging>
  <properties>
    <app.runtime>4.12.3</app.runtime>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build><plugins>
    <plugin>
      <groupId>org.mule.tools.maven</groupId>
      <artifactId>mule-maven-plugin</artifactId>
      <version>4.10.0</version>
      <extensions>true</extensions>
      <configuration>
        <skipAST>true</skipAST>
        <classifier>mule-application</classifier>
        <cloudhub2Deployment>
          <uri>${deploy.controlPlane}</uri><provider>MC</provider>
          <businessGroupId>${exchange.organizationId}</businessGroupId>
          <environment>${deploy.environment}</environment><target>${deploy.target}</target>
          <applicationName>${deploy.application}</applicationName>
          <muleVersion>${deploy.runtimeImage}</muleVersion>
          <releaseChannel>EDGE</releaseChannel><javaVersion>17</javaVersion>
          <replicas>1</replicas><vCores>${deploy.vCores}</vCores>
          <connectedAppClientId>${env.MULE_CONNECTED_APP_ID}</connectedAppClientId>
          <connectedAppClientSecret>${env.MULE_CONNECTED_APP_SECRET}</connectedAppClientSecret>
          <connectedAppGrantType>client_credentials</connectedAppGrantType>
          <properties>
            <api.id>${deploy.apiId}</api.id><catalogue.host>${deploy.catalogueHost}</catalogue.host>
            <db.url>${deploy.dbUrl}</db.url><db.user>${deploy.dbUser}</db.user>
          </properties>
          <secureProperties><db.password>${env.ORDERS_DB_PASSWORD}</db.password></secureProperties>
        </cloudhub2Deployment>
        <sharedLibraries><sharedLibrary><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></sharedLibrary></sharedLibraries>

      </configuration>
    </plugin>

  </plugins></build>
  <dependencies>
    <dependency>
      <groupId>org.mule.connectors</groupId>
      <artifactId>mule-http-connector</artifactId>
      <version>1.11.3</version>
      <classifier>mule-plugin</classifier>
    </dependency>
    <dependency>
      <groupId>org.mule.connectors</groupId>
      <artifactId>mule-db-connector</artifactId>
      <version>1.15.1</version>
      <classifier>mule-plugin</classifier>
    </dependency>
    <dependency>
      <groupId>org.mule.modules</groupId>
      <artifactId>mule-apikit-module</artifactId>
      <version>1.11.17</version>
      <classifier>mule-plugin</classifier>
    </dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.5</version></dependency>
  </dependencies>
  <repositories><repository><id>mulesoft-releases</id><url>https://repository.mulesoft.org/releases/</url></repository></repositories>
  <pluginRepositories><pluginRepository><id>mulesoft-releases</id><url>https://repository.mulesoft.org/releases/</url></pluginRepository></pluginRepositories>
  <distributionManagement><repository><id>exchange-releases</id>
    <url>${exchange.repositoryUrl}</url>
  </repository></distributionManagement>
</project>
